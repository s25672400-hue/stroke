    <script>
        // 設定重新整理 iframe 的時間間隔 (毫秒)
        // 注意：因為多個字的筆畫數不同，你需要取一個「最長」的播放時間作為基準
        const refreshInterval = 40000; // 40 秒

        function refreshAllIframes() {
            // 使用 querySelectorAll 找到所有 class 為 stroke-iframe 的元素
            const iframes = document.querySelectorAll('.stroke-iframe');
            
            // 使用 forEach 迴圈，將每一個 iframe 重新載入
            iframes.forEach(function(iframe) {
                iframe.src = iframe.src;
            });
        }

        // 使用 setInterval 定時執行
        setInterval(refreshAllIframes, refreshInterval);
    </script>

